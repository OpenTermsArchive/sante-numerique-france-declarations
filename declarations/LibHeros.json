{
  "name": "LibHéros",
  "terms": {
    "Privacy Policy": {
      "fetch": "https://libheros.fr/a-propos/politique-confidentialite",
      "select": [
        "main"
      ],
      "remove": [
        ".object-cover"
      ]
    },
    "Terms of Service": {
      "fetch": "https://www.libheros.fr/a-propos/cgps",
      "select": [
        "main"
      ],
      "remove": [
        ".object-cover"
      ]
    },
    "Imprint": {
      "fetch": "https://www.libheros.fr/a-propos/cgps",
      "filter": [
        "addIDsToAllowSelection"
      ],
      "select": {
        "startBefore": "#mentions-legales",
        "endBefore": "#objet-validation-acceptation"
      },
      "remove": [
        ".responsive-image"
      ]
    }
  }
}
